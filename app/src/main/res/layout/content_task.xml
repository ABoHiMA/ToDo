<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:backgroundTint="@color/secondaryColor"
    app:cardCornerRadius="18dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="18dp"
        android:paddingVertical="24dp">

        <ImageView
            android:id="@+id/img_status"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:src="@color/primaryColor"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primaryColor"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_time"
            app:layout_constraintEnd_toStartOf="@id/card_check"
            app:layout_constraintStart_toEndOf="@id/img_status"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@tools:sample/lorem" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/tv_date"
            app:layout_constraintStart_toEndOf="@id/img_status"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            tools:text="@tools:sample/date/hhmm" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/tv_title"
            app:layout_constraintStart_toEndOf="@id/img_status"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"
            tools:text="@tools:sample/date/ddmmyy" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_check"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:layout_margin="18dp"
            android:backgroundTint="@color/primaryColor"
            app:cardCornerRadius="158dp"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/img_check"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_check" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_check"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="18dp"
            android:gravity="center"
            android:textColor="@color/onSecondaryColor"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="@string/done" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</com.google.android.material.card.MaterialCardView>