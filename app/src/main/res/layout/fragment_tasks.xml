<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.home.tabs.settings.SettingsFragment">

    <ImageView
        android:id="@+id/img_bar"
        android:layout_width="match_parent"
        android:layout_height="99dp"
        android:src="@color/primaryColor"
        app:layout_constraintTop_toTopOf="parent" />

    <com.prolificinteractive.materialcalendarview.MaterialCalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="18dp"
        android:background="@drawable/calendar_corner"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:mcv_calendarMode="week"
        app:mcv_dateTextAppearance="@color/colorText"
        app:mcv_selectionColor="@color/primaryColor"
        app:mcv_showOtherDates="all"
        app:mcv_weekDayTextAppearance="@color/colorText">

        <Button
            android:id="@+id/btn_All"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/all_tasks"
            android:textColor="@color/colorText"
            android:textSize="16sp" />

    </com.prolificinteractive.materialcalendarview.MaterialCalendarView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        tools:listitem="@layout/item_task" />

</androidx.constraintlayout.widget.ConstraintLayout>